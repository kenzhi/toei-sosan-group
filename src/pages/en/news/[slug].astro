---
import ArticleLayout from '../../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const news = await getCollection('news', c => c.data.lang === 'en');
  return Promise.all(news.map(async (entry) => {
    const related = (await getCollection('news', c =>
      c.data.lang === 'en' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="news"
  backLabel="Back to News"
  backHref="/en/news/"
  ctaTitle="Stay in the loop?"
  ctaButton="Contact Us"
  ctaHref="/en/contact/"
  relatedTitle="News"
  related={related}
  lang="en"
/>
