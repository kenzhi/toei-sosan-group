---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';

const faq = [
  { q: 'Is the initial consultation free?', a: 'Yes, the initial consultation is free. We cover requirements gathering and proposal suggestions.' },
  { q: 'Where do you operate?', a: 'From Japan (Saitama) and China (Dongguan), we cover all of Japan, mainland China, and global markets.' },
  { q: 'Do you accept small-batch or prototype orders?', a: 'Yes. We support prototypes, small batches, and mass production.' },
  { q: 'How long from signing to execution?', a: 'Depends on the project, but the fastest can start within 2 weeks.' }
];

// Cloudflare Turnstile — get site key from Cloudflare Dashboard → Turnstile → Add site
// Set PUBLIC_TURNSTILE_SITE_KEY env var to enable; secret goes in web3forms backend
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const isSubmitted = Astro.url.searchParams.get('submitted') === '1';
---
<Layout title="Contact | Toei Sosan Group" description="Get in touch for OEM manufacturing, cross-border e-commerce, or international trade inquiries." lang="en">
  <Nav />

  <PageHero eyebrow="CONTACT" title="Start with a Conversation" subtitle="Whether it's a project inquiry, a job application, or just curiosity — all welcome." />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="form-wrap">
          <h2>Send a Message</h2>
          <div class="success-card" id="contact-success" role="status" aria-live="polite">
            <div class="success-icon" aria-hidden="true">✓</div>
            <h3 class="success-title">Thank you for reaching out</h3>
            <p class="success-desc">We've received your message and will reply within <strong>24 hours</strong>.<br />If you don't see our reply, please check your spam folder.</p>
            <a href="/en/" class="btn btn-primary">Back to Home</a>
          </div>
          <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="e9b29e3d-a8ad-45e6-9f75-44a84ee2c156" />
            <input type="hidden" name="subject" value="Toei Sosan Group — New Inquiry" />
            <input type="hidden" name="from_name" value="Toei Sosan Group Website" />
            <input type="hidden" name="redirect" value="https://toei-sosan.com/en/contact/?submitted=1" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

            <div class="form-row">
              <label>
                <span>Name <em>*</em></span>
                <input type="text" name="name" required />
              </label>
              <label>
                <span>Company</span>
                <input type="text" name="company" />
              </label>
            </div>
            <label>
              <span>Email <em>*</em></span>
              <input type="email" name="email" required />
            </label>
            <label>
              <span>Phone</span>
              <input type="tel" name="phone" />
            </label>
            <label>
              <span>Service of Interest</span>
              <select name="service">
                <option>OEM Manufacturing</option>
                <option>Cross-border E-commerce</option>
                <option>International Trade</option>
                <option>Product Design</option>
                <option>Other</option>
              </select>
            </label>
            <label>
              <span>Message <em>*</em></span>
              <textarea name="message" rows="6" required></textarea>
            </label>
            <label class="check">
              <input type="checkbox" name="agree" required />
              <span>I agree to the privacy policy</span>
            </label>

            {TURNSTILE_SITE_KEY && (
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
            )}

            <button type="submit" class="btn btn-primary" id="contact-submit">Send</button>
          </form>
        </div>

        <aside class="info-wrap">
          <h2>Contact Info</h2>
          <div class="info-block">
            <div class="info-label">Email</div>
            <a href="mailto:info@toei-sosan.com" class="info-value">info@toei-sosan.com</a>
          </div>
          {/* v1.28: WhatsApp — 日本 B2B 客户首选即时通讯, 上线前替换占位号 */}
          <div class="info-block">
            <div class="info-label">WhatsApp (Japan HQ)</div>
            <a href="https://wa.me/813012345678" class="info-value" target="_blank" rel="noopener">+81 3012 1234 5678 (English / 日本語)</a>
          </div>
          <div class="info-block">
            <div class="info-label">Japan HQ (Saitama)</div>
            <p class="info-value">
              〒343-0828<br />
              8-125 Lake-Town 8-chome, Koshigaya, Saitama
            </p>
          </div>
          <div class="info-block">
            <div class="info-label">China</div>
            <p class="info-value">Dongcheng Subdistrict, Dongguan, Guangdong</p>
          </div>
          <div class="info-block">
            <div class="info-label">Hours</div>
            <p class="info-value">Mon-Fri 9:00 - 18:00 (JST)</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container narrow">
      <h2 class="section-title">FAQ</h2>
      <div class="faq-list">
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  {TURNSTILE_SITE_KEY && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script>
    // 1) Static build 不会渲染 success card — 在客户端检测 ?submitted=1
    const params = new URLSearchParams(window.location.search);
    if (params.get('submitted') === '1') {
      const form = document.getElementById('contact-form');
      const successCard = document.getElementById('contact-success');
      if (form) form.style.display = 'none';
      if (successCard) {
        successCard.style.display = 'block';
        successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
    // 2) 提交时按钮 loading + disable
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (form && submitBtn) {
      form.addEventListener('submit', () => {
        submitBtn.classList.add('is-loading');
        submitBtn.disabled = true;

        // v1.14: dual-POST — 表单同时发一份到 Trade OS (不阻塞 Web3Forms 邮件流程)
        const formData = new FormData(form);
        fetch('https://app.maclog.cn/api/inquiries/webhook/web3forms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData)),
        }).catch((err) => {
          console.warn('Trade OS 同步失败, 但邮件已发:', err);
        });
      });
    }
  </script>
</Layout>

<style>
  .success-card {
    display: none;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-white) 100%);
    border: 1.5px solid var(--color-accent);
    border-radius: 4px;
    padding: 3rem 2rem;
    text-align: center;
    animation: successIn 0.5s var(--ease) both;
  }
  .success-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-size: 2rem;
    font-weight: 700;
    line-height: 64px;
    margin: 0 auto 1.5rem;
    box-shadow: 0 4px 16px rgba(226, 156, 82, 0.3);
  }
  .success-title {
    font-size: 1.375rem;
    color: var(--color-primary);
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .success-desc {
    color: var(--color-text-soft);
    line-height: 1.8;
    margin: 0 0 2rem;
  }
  .success-desc strong { color: var(--color-accent); }
  @keyframes successIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .form button[type="submit"].is-loading {
    opacity: 0.7; pointer-events: none; position: relative; color: transparent;
  }
  .form button[type="submit"].is-loading::after {
    content: ''; position: absolute; top: 50%; left: 50%;
    width: 18px; height: 18px; margin: -9px 0 0 -9px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white; border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .contact-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; }
  .form-wrap h2, .info-wrap h2 { font-size: 1.25rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
  .form { display: flex; flex-direction: column; gap: 1.5rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .form label { display: flex; flex-direction: column; gap: 0.5rem; }
  .form label > span { font-size: 0.875rem; font-weight: 500; color: var(--color-text); }
  .form label > span em { color: var(--color-accent); font-style: normal; margin-left: 0.25rem; }
  .form input, .form textarea, .form select { font-family: var(--font-sans); font-size: 1rem; padding: 0.75rem 1rem; border: 1px solid var(--color-border); background: var(--color-bg-white); border-radius: var(--radius); transition: border-color 0.2s; }
  .form input:focus, .form textarea:focus, .form select:focus { outline: none; border-color: var(--color-primary); }
  .form textarea { resize: vertical; min-height: 140px; }
  .form .check { flex-direction: row; align-items: center; gap: 0.5rem; }
  .form .check span { font-size: 0.875rem; color: var(--color-text-soft); }
  .form button { align-self: flex-start; margin-top: 0.5rem; }
  .info-wrap { background: var(--color-bg-white); border: 1px solid var(--color-border-soft); padding: 2.5rem; }
  .info-block { margin-bottom: 1.75rem; }
  .info-block:last-child { margin-bottom: 0; }
  .info-label { font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.15em; margin-bottom: 0.5rem; }
  .info-value { font-size: 0.9375rem; color: var(--color-text); line-height: 1.6; margin: 0; }
  .faq-section { background: var(--color-bg-white); }
  .narrow { max-width: 720px; margin: 0 auto; }
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item { background: var(--color-bg); border: 1px solid var(--color-border-soft); padding: 1.25rem 1.5rem; }
  .faq-item summary { font-weight: 500; color: var(--color-primary); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--color-accent); transition: transform 0.2s; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: 1rem 0 0; color: var(--color-text-soft); line-height: 1.7; }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } .form-row { grid-template-columns: 1fr; } }
</style>
