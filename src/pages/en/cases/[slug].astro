---
import ArticleLayout from '../../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const cases = await getCollection('cases', c => c.data.lang === 'en');
  return Promise.all(cases.map(async (entry) => {
    const related = (await getCollection('cases', c =>
      c.data.lang === 'en' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="cases"
  backLabel="Back to Case Studies"
  backHref="/en/cases/"
  ctaTitle="Want your project executed end-to-end too?"
  ctaButton="Contact Us"
  ctaHref="/en/contact/"
  relatedTitle="Case Studies"
  related={related}
  lang="en"
/>
