---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import PageHero from '../../../components/PageHero.astro';
import Footer from '../../../components/Footer.astro';

const items = [
  {
    src: '/images/site/past-products/cableprotectors-1.jpg',
    label: 'Cable protectors (character design)',
    process: 'Injection + painting + assembly',
    material: 'PVC / soft resin',
  },
  {
    src: '/images/site/past-products/cableprotectors-2.jpg',
    label: 'Cable protectors (variations)',
    process: 'Injection + painting + assembly',
    material: 'PVC / soft resin',
  },
  {
    src: '/images/site/past-products/usbcables.jpg',
    label: 'USB charging cable (with character cover)',
    process: 'Injection + assembly + packaging',
    material: 'PVC / TPE / cable',
  },
  {
    src: '/images/site/past-products/charger-dalmatian.jpg',
    label: 'USB charger (animal design / retail pack)',
    process: 'Injection + assembly + packaging',
    material: 'ABS / PVC / retail pack',
  },
  {
    src: '/images/site/past-products/charger.jpg',
    label: 'USB wall charger',
    process: 'Injection + assembly',
    material: 'ABS / PC',
  },
  {
    src: '/images/site/past-products/anpanman.jpg',
    label: 'Anpanman Bakery toy set',
    process: 'Injection + painting + assembly + packaging',
    material: 'ABS / PVC',
  },
  {
    src: '/images/site/past-products/spiderman.jpg',
    label: 'Vinyl figure (Funko-style)',
    process: 'Injection + painting + assembly',
    material: 'PVC / paint',
  },
];
---
<Layout title="Past Products | TOEI SOSAN GROUP" description="Sample OEM products manufactured by TOEI SOSAN GROUP (some processed for IP protection).">
  <Nav />
  <PageHero
    eyebrow="PAST PRODUCTS"
    title="Past Product Samples"
    subtitle="Sample OEM products manufactured by TOEI SOSAN GROUP. Character toys, USB accessories, and chargers — produced in our self-operated Dongguan, China facility."
  />
  <section class="section">
    <div class="container">
      <div class="note">
        ※ Some images are lightly mosaic-blurred on the character faces only, to respect third-party IP. Body, form, and material details remain visible for reference.
      </div>
      <div class="gallery">
        {items.map(it => (
          <figure class="card">
            <div class="img-wrap">
              <img src={it.src} alt={it.label} loading="lazy" />
            </div>
            <figcaption>
              <h3>{it.label}</h3>
              <dl>
                <dt>Process</dt><dd>{it.process}</dd>
                <dt>Material</dt><dd>{it.material}</dd>
              </dl>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .section { padding: 4rem 0 6rem; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .note {
    font-size: 0.875rem;
    color: #5A5A5A;
    background: #F7F4ED;
    border-left: 3px solid #E29C52;
    padding: 0.875rem 1.125rem;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  .card {
    margin: 0;
    background: #FFFFFF;
    border: 1px solid #E8E2D5;
    transition: all 0.3s;
    overflow: hidden;
  }
  .card:hover {
    border-color: #1B3A5C;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(27,58,92,0.08);
  }
  .img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #F4F0E6;
  }
  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  figcaption h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1B3A5C;
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
  }
  figcaption dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  figcaption dt {
    color: #8A8A8A;
    font-weight: 500;
  }
  figcaption dd {
    color: #1B3A5C;
    margin: 0;
  }
</style>
