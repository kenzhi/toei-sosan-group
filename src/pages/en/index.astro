---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../i18n/ui';

const capabilities = [
  { num: '01', icon: 'factory', title: 'OEM Manufacturing', desc: 'Specializing in collectible figurines, character toys, and PVC figures from our 10-year Dongguan factory. Full process: plastic injection → painting → assembly → packaging → warehousing. Japanese quality standards realized in Chinese manufacturing capacity.' },
  { num: '02', icon: 'globe',   title: 'Cross-border E-commerce', desc: 'Cross-border e-commerce operations across Japan, China, and Southeast Asia. Covering Amazon, Rakuten, Tmall, and Shopee with integrated logistics, customs, and customer service.' },
  { num: '03', icon: 'ship',    title: 'International Trade', desc: 'B2B trade across all of Asia, anchored at our Saitama HQ. From raw material sourcing to finished goods export, the entire supply chain covered.' }
];

const areas = [
  { tag: 'MANUFACTURING', title: 'Precision Manufacturing & Quality Control', desc: 'End-to-end production in our own facilities',
    img: '/images/factory/上色 1 - heavy-blur.webp',
    href: '/en/factory/' },
  { tag: 'LOGISTICS', title: 'International Logistics & Supply Chain', desc: 'Optimized routes between Saitama and Dongguan',
    img: '/images/factory/仓储 1 - heavy-blur.webp',
    href: '/en/logistics/' },
  { tag: 'E-COMMERCE', title: 'Cross-border E-commerce & Digital Marketing', desc: 'Unified multi-platform operations',
    img: '/images/site/ecommerce.jpg',
    href: '/en/ecommerce/' },
  { tag: 'CONSULTING', title: 'Market Entry & Business Consulting', desc: 'Legal, tax, and market-entry support across Japan and China',
    img: '/images/site/consulting.jpg',
    href: '/en/consulting/' }
];

const allArticles = [
  ...(await getCollection('cases', c => c.data.lang === 'en' && !c.data.draft))
    .map(e => ({ ...e, kind: 'cases' as const, kindLabel: 'Case Study' })),
  ...(await getCollection('insights', c => c.data.lang === 'en' && !c.data.draft))
    .map(e => ({ ...e, kind: 'insights' as const, kindLabel: 'Insight' })),
  ...(await getCollection('news', c => c.data.lang === 'en' && !c.data.draft))
    .map(e => ({ ...e, kind: 'news' as const, kindLabel: 'News' })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const defaultCovers: Record<string, string> = {
  cases: '/images/site/trade.jpg',
  insights: '/images/site/consulting.jpg',
  news: '/images/site/ecommerce.jpg',
};

const featuredProducts = (await getCollection('products', p => p.data.lang === 'en' && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const faq = [
  { q: 'Is the initial consultation free?', a: 'Yes—your first consultation is free, from scoping your challenge to a high-level proposal. Reach out any time.' },
  { q: 'What regions do you serve?', a: 'From our Saitama HQ (Koshigaya) and Dongguan, Guangdong base, we cover all of Japan, mainland China, and Southeast Asia.' },
  { q: 'Do you handle small-batch or prototype runs?', a: 'Yes. OEM manufacturing starts at 100 units; cross-border e-commerce from 1 SKU.' },
  { q: 'How long from contract to kickoff?', a: 'Depends on scope—some projects kick off in as little as two weeks. Urgent cases can be expedited on request.' },
  { q: 'What does your quality control system look like?', a: 'A Japanese-stationed QC team at our Dongguan factory runs ISO 9001-aligned inspections, pre-shipment checks, and sample dimensional reporting.' },
  { q: 'Can we sign an NDA?', a: 'Yes. We can sign an NDA before the first conversation so your technology and customer data stay protected.' },
  { q: 'What payment methods do you accept?', a: 'JPY, RMB, and USD. Wire transfer (T/T) is standard; L/C available for larger projects.' },
  { q: 'Do you support online meetings?', a: 'Yes—Zoom, Teams, and Google Meet all work, and we can flex between JST and CST time zones.' },
  // v1.28: OEM-specific FAQ for B2B collectors/character-toy clients
  { q: 'What is your OEM minimum order quantity?', a: 'Standard MOQ is 500 units per SKU for mass production; prototype runs start at 100 units. Mix-SKU orders can be arranged in 1 master carton if total ≥ 500 units.' },
  { q: 'Do you support client-owned tooling and IP?', a: 'Yes. We can work with client-supplied tooling, or develop new tooling in-house. All client IP and tooling remains the property of the client, with NDA protection throughout the process.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<Layout
  title="Toy OEM Manufacturer in China | Toei Sosan Group"
  description="OEM toy manufacturer in Dongguan, China. 10+ years of craft in collectible figurines, character toys, and PVC figures. Japan-based QC. Get a quote today."
  keywords="OEM toy manufacturer, figurine OEM, China factory, collectible manufacturer, PVC figure, character toy, Dongguan factory, Japan QC, OEM manufacturing"
  lang="en"
>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-bg-accent" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="hero-eyebrow"><span class="eyebrow-line"></span><span class="eyebrow-text">JAPAN × CHINA × GLOBAL</span></div>
        <h1 class="hero-title">From Chinese factories,<br/>to global markets.</h1>
        <p class="hero-sub">A real-industry group that fuses Japanese quality standards with Chinese manufacturing power, delivering value from Asia to the world.</p>
        <a href="/en/services/" class="hero-cta">START YOUR PROJECT <span aria-hidden="true">→</span></a>
        <div class="hero-scroll" aria-hidden="true"><span></span><span class="scroll-label">SCROLL</span></div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hv-frame1"></div>
        <div class="hv-frame2"></div>
        <div class="hv-photo">
          <img src="/images/site/team.jpg" alt="" loading="eager" />
        </div>
        <div class="hv-corner tl"></div>
        <div class="hv-corner br"></div>
        <div class="hv-dot dot1"></div>
        <div class="hv-dot dot2"></div>
      </div>
    </div>
  </section>

  <!-- CORE CAPABILITIES -->
  <section class="caps section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>CORE CAPABILITIES</span></div>
      <h2 class="sec-title">Three core businesses,<br/><span class="t-accent">connected to the world</span></h2>
      <div class="caps-grid">
        {capabilities.map(c => (
          <article class="cap-card">
            <div class="cap-head">
              <span class="cap-num">{c.num}</span>
              <span class="cap-icon" data-icon={c.icon}></span>
            </div>
            <h3 class="cap-title">{c.title}</h3>
            <p class="cap-desc">{c.desc}</p>
            <div class="cap-more"><span class="dot"></span><span>DETAILS</span></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BUSINESS AREAS -->
  <section class="areas section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>BUSINESS AREAS</span></div>
      <h2 class="sec-title">Business areas</h2>
      <div class="areas-grid">
        {areas.map(a => (
          <a href={a.href} class="area-card">
            <img src={a.img} alt={a.title} loading="lazy"  decoding="async" />
            <div class="area-overlay"></div>
            <div class="area-content">
              <span class="area-tag">{a.tag}</span>
              <h3 class="area-title">{a.title}</h3>
              <p class="area-desc">{a.desc}</p>
            </div>
            <div class="area-corner"></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BRAND STORY -->
  <section class="story section">
    <div class="story-bg" aria-hidden="true">
      <svg viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice">
        <path d="M0 400 Q360 300 720 400 T1440 400" stroke="#1B3A5C" stroke-width="0.8" fill="none" />
        <path d="M0 340 Q360 240 720 340 T1440 340" stroke="#1B3A5C" stroke-width="0.4" fill="none" />
        <path d="M0 460 Q360 360 720 460 T1440 460" stroke="#1B3A5C" stroke-width="0.4" fill="none" />
        <path d="M200 0 Q300 400 200 800" stroke="#E29C52" stroke-width="0.4" fill="none" />
        <path d="M600 0 Q500 400 600 800" stroke="#1B3A5C" stroke-width="0.3" fill="none" />
        <path d="M1000 0 Q1100 400 1000 800" stroke="#1B3A5C" stroke-width="0.3" fill="none" />
        <path d="M1300 0 Q1200 400 1300 800" stroke="#E29C52" stroke-width="0.4" fill="none" />
        <circle cx="350" cy="375" r="4" fill="#E29C52" opacity="0.5" />
        <circle cx="720" cy="400" r="3" fill="#1B3A5C" opacity="0.4" />
        <circle cx="1100" cy="425" r="4" fill="#E29C52" opacity="0.5" />
      </svg>
    </div>
    <div class="container story-inner">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>BRAND STORY</span></div>
      <div class="story-grid">
        <div class="story-left">
          <div class="story-photo">
            <img src="/images/site/team.jpg" alt="Saitama office" loading="lazy"  decoding="async" />
            <div class="story-photo-frame"></div>
          </div>
          <blockquote class="story-quote">
            <p>"100% real-industry spirit"</p>
            <cite>── The core belief of Toei Sosan</cite>
          </blockquote>
        </div>
        <div class="story-right">
          <h2 class="story-title">Koshigaya, Saitama × Dongguan, Guangdong<br/><span class="t-accent">Two locations, one spirit</span></h2>
          <p>TOEI SOSAN GROUP is a Japan-China integrated real-industry group, headquartered in Koshigaya, Saitama with production facilities in Dongguan, Guangdong. Since 2015 we have honed our OEM craft in our Dongguan factory; in 2025, with our Saitama HQ established, we fuse that craft with Japanese planning and quality standards, delivering value across Asia and the world.</p>
          <p>Since our founding, we have held firm to the principle: <em>never leave the factory floor</em>. With management that sees through to the essence of making things, we pursue the optimal answer in the global supply chain—together with our partner companies.</p>
          <div class="story-metrics">
            <div><span class="m-val" data-countup="10" data-countup-duration="1200" data-countup-suffix="+">0</span><span class="m-suf">years</span><span class="m-lbl">Dongguan factory craft</span></div>
            <div><span class="m-val" data-countup="5" data-countup-duration="1200">0</span><span class="m-suf">stages</span><span class="m-lbl">PRODUCTION PROCESS</span></div>
            <div><span class="m-val" data-countup="100" data-countup-duration="1800" data-countup-suffix="K+">0</span><span class="m-suf">pcs</span><span class="m-lbl">MONTHLY CAPACITY</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq section">
    <div class="container narrow">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>FAQ</span></div>
      <h2 class="sec-title">Frequently <span class="t-accent">Asked</span></h2>
      <div class="faq-list">
        {faq.map((f, i) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq-q">{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="products-section section">
    <div class="container">
      <div class="products-section-header">
        <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>PRODUCTS</span></div>
        <h2 class="sec-title">In-house <span class="t-accent">product line</span></h2>
        <p class="products-section-sub">Metal processing, plastic injection, electronics assembly, packaging.<br />OEM / ODM both supported, across 6 categories.</p>
      </div>
      <div class="products-section-grid">
        {featuredProducts.map(p => (
          <a href={`/en/products/${cleanSlug(p.slug)}/`} class="product-section-card">
            <div class="product-section-cover" style={`background-image: url(${(p.data as any).cover})`}>
              <span class="product-section-cat">{(p.data as any).category}</span>
            </div>
            <div class="product-section-content">
              <h3>{(p.data as any).title}</h3>
              <p>{(p.data as any).excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="products-section-cta">
        <a href="/en/products/" class="btn-outline">View all products →</a>
      </div>
    </div>
  </section>

  <!-- LATEST ARTICLES -->
  <section class="articles section">
    <div class="container">
      <div class="articles-header">
        <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>LATEST</span></div>
        <h2 class="sec-title">Latest <span class="t-accent">insights &amp; cases</span></h2>
      </div>
      <div class="articles-grid">
        {allArticles.map(article => {
          const cover = (article.data as any).cover || defaultCovers[article.kind];
          return (
            <a href={`/en/${article.kind}/${cleanSlug(article.slug)}/`} class="article-card">
              <div class="article-cover" style={`background-image: url(${cover})`}>
                <span class="article-kind">{article.kindLabel}</span>
                <div class="article-cover-overlay"></div>
              </div>
              <div class="article-content">
                <div class="article-meta">
                  <time>{article.data.date.toISOString().split('T')[0]}</time>
                  {article.data.industry && <span class="article-tag">{article.data.industry}</span>}
                  {article.data.category && <span class="article-tag">{article.data.category}</span>}
                </div>
                <h3 class="article-title">{article.data.title}</h3>
                <p class="article-excerpt">{article.data.excerpt}</p>
                <span class="article-link">Read article <span class="arrow">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta section">
    <div class="container">
      <div class="cta-grid">
        <a href="/en/contact/" class="cta-box cta-primary">
          <span class="cta-eyebrow">Contact</span>
          <h3>Start with a<br/>project consultation.</h3>
          <span class="cta-arrow">→</span>
        </a>
        <a href="/en/about/" class="cta-box">
          <span class="cta-eyebrow">About us</span>
          <h3>Why "real industry"?<br/>Hear the reason.</h3>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>

<style>
  .hero { min-height: calc(100vh - 70px); display: flex; align-items: center; position: relative; overflow: hidden;
    background: linear-gradient(135deg, white 0%, var(--color-bg) 100%); padding: 4rem 0 6rem; }
  .hero-bg-grid { position: absolute; inset: 0; opacity: 0.03; pointer-events: none;
    background-image:
      linear-gradient(to right, var(--color-primary) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-primary) 1px, transparent 1px);
    background-size: 60px 60px; }
  .hero-bg-accent { position: absolute; top: 0; right: 0; width: 33%; height: 100%;
    background: linear-gradient(225deg, var(--color-primary-fade) 0%, transparent 70%); pointer-events: none; }
  .hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 7fr 5fr; gap: 3rem; align-items: center; }
  .hero-text { position: relative; padding-top: 2rem; }
  .hero-eyebrow { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;
    animation: fadeInUp 0.8s var(--ease) both; }
  .eyebrow-line { display: block; width: 64px; height: 3px; background: var(--color-accent); border-radius: 999px;
    animation: lineExpand 1s var(--ease) 0.4s both; }
  @keyframes lineExpand { from { width: 0; } to { width: 64px; } }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  .eyebrow-text { font-family: var(--font-en); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.35em; color: var(--color-primary); opacity: 0.55; }
  .hero-title { font-size: clamp(2.5rem, 5.5vw, 4.5rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.01em;
    color: var(--color-primary); margin: 0 0 1.5rem; animation: fadeInUp 0.8s var(--ease) 0.1s both; }
  .hero-sub { font-family: var(--font-sc); font-size: 1.0625rem; line-height: 1.85; color: var(--color-text-soft);
    max-width: 30rem; margin: 0 0 2.5rem; animation: fadeInUp 0.8s var(--ease) 0.2s both; }
  .hero-cta { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem;
    font-family: var(--font-en); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.25em;
    color: var(--color-primary); border: 2px solid var(--color-primary); border-radius: 2px;
    text-decoration: none; transition: var(--transition); animation: fadeInUp 0.8s var(--ease) 0.3s both; }
  .hero-cta:hover { background: var(--color-primary); color: white; transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(27, 58, 92, 0.25); }
  .hero-cta span { transition: transform 0.3s var(--ease); }
  .hero-cta:hover span { transform: translateX(4px); }
  .hero-scroll { display: flex; align-items: center; gap: 0.75rem; margin-top: 5rem; opacity: 0.5; }
  .hero-scroll span:first-child { display: block; width: 2px; height: 56px;
    background: linear-gradient(180deg, var(--color-primary) 0%, transparent 100%); border-radius: 999px; }
  .scroll-label { font-family: var(--font-en); font-size: 0.625rem; letter-spacing: 0.3em; color: var(--color-primary); opacity: 0.6; }
  .hero-visual { position: relative; aspect-ratio: 1; max-width: 480px; margin: 0 auto; width: 100%;
    animation: floatSlow 7s ease-in-out infinite; }
  @keyframes floatSlow { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-10px) rotate(0.5deg); } }
  .hv-frame1 { position: absolute; top: 8%; right: 8%; width: 72%; height: 72%;
    border: 1px solid var(--color-primary); opacity: 0.2; transform: rotate(12deg); border-radius: 2px; }
  .hv-frame2 { position: absolute; top: 18%; right: 18%; width: 58%; height: 58%;
    background: var(--color-primary-fade); transform: rotate(-6deg); border-radius: 2px; }
  .hv-photo { position: absolute; top: 12%; left: 12%; width: 65%; height: 65%;
    border-radius: 2px; overflow: hidden; box-shadow: 0 24px 64px rgba(15, 23, 42, 0.18); }
  .hv-photo img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .hv-corner { position: absolute; width: 40px; height: 40px; }
  .hv-corner.tl { top: 0; left: 0; border-top: 2px solid var(--color-primary); border-left: 2px solid var(--color-primary); }
  .hv-corner.br { bottom: 0; right: 0; border-bottom: 2px solid var(--color-accent); border-right: 2px solid var(--color-accent); }
  .hv-dot { position: absolute; border-radius: 50%; }
  .hv-dot.dot1 { bottom: 18%; left: 3%; width: 12px; height: 12px; background: var(--color-accent);
    box-shadow: 0 4px 12px rgba(226, 156, 82, 0.4); }
  .hv-dot.dot2 { top: 5%; right: 5%; width: 8px; height: 8px; background: var(--color-primary); }

  .sec-eyebrow { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .sec-eyebrow .eyebrow-line { width: 32px; height: 2px; animation: none; }
  .sec-eyebrow span:last-child { font-family: var(--font-en); font-size: 0.6875rem; font-weight: 600;
    letter-spacing: 0.35em; color: var(--color-primary); opacity: 0.6; text-transform: uppercase; }
  .sec-title { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 600; color: var(--color-primary);
    line-height: 1.3; margin: 0 0 3.5rem; }
  .t-accent { color: var(--color-accent); }

  .caps { background: var(--color-bg); }
  .caps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .cap-card { background: white; border: 1px solid transparent; border-radius: var(--radius-lg);
    padding: 2.5rem 2rem; transition: var(--transition); cursor: pointer; }
  .cap-card:hover { border-color: var(--color-accent);
    box-shadow: 0 8px 32px rgba(27, 58, 92, 0.08), 0 0 0 1px var(--color-accent); transform: translateY(-4px); }
  .cap-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .cap-num { font-family: var(--font-display); font-size: 2.75rem; font-weight: 400; line-height: 1;
    color: var(--color-primary); opacity: 0.15; transition: color 0.4s var(--ease); }
  .cap-card:hover .cap-num { color: var(--color-accent); }
  .cap-icon { width: 40px; height: 40px; border-radius: 50%; background: var(--color-primary-fade);
    display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: var(--color-primary);
    opacity: 0.6; transition: var(--transition); }
  .cap-card:hover .cap-icon { background: var(--color-primary); opacity: 0.9; }
  .cap-title { font-size: 1.5rem; font-weight: 600; color: var(--color-primary); margin: 0 0 1rem; }
  .cap-desc { font-family: var(--font-sc); font-size: 0.875rem; line-height: 1.85; color: var(--color-text-soft);
    margin: 0; }
  .cap-more { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.75rem;
    opacity: 0; transition: opacity 0.4s var(--ease); }
  .cap-card:hover .cap-more { opacity: 1; }
  .cap-more .dot { width: 32px; height: 2px; background: var(--color-accent); border-radius: 999px; }
  .cap-more span:last-child { font-family: var(--font-en); font-size: 0.625rem; font-weight: 600;
    letter-spacing: 0.2em; color: var(--color-accent); }

  .areas { background: white; }
  .areas-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .area-card { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: var(--radius-lg);
    background: var(--color-bg-soft); display: block; text-decoration: none; }
  .area-card img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); opacity: 0.75;
    transition: all 0.7s var(--ease); }
  .area-card:hover img { filter: grayscale(0); opacity: 1; transform: scale(1.05); }
  .area-overlay { position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(27, 58, 92, 0.7) 0%, rgba(27, 58, 92, 0.2) 50%, transparent 100%); }
  .area-content { position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem; }
  .area-tag { font-family: var(--font-en); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.3em;
    color: var(--color-accent); text-transform: uppercase; }
