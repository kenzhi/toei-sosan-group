---
import ArticleLayout from '../../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const insights = await getCollection('insights', c => c.data.lang === 'en');
  return Promise.all(insights.map(async (entry) => {
    const related = (await getCollection('insights', c =>
      c.data.lang === 'en' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="insights"
  backLabel="Back to Insights"
  backHref="/en/insights/"
  ctaTitle="Want to go deeper on any of these?"
  ctaButton="Contact Us"
  ctaHref="/en/contact/"
  relatedTitle="Insights"
  related={related}
  lang="en"
/>
