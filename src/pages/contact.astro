---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';

const faq = [
  { q: '初回相談は有料ですか？', a: '初回相談は無料です。課題のヒアリングとご提案まで、お気軽にどうぞ。' },
  { q: '対応エリアは？', a: '日本（埼玉）と中国（東莞）の二拠点で、日本全国・中国全土・グローバルに対応します。' },
  { q: '小ロット（試作）も可能ですか？', a: 'はい、試作・小ロットから対応可能です。詳細はお問い合わせください。' },
  { q: '契約から実行までの期間は？', a: '内容により異なりますが、最短 2 週間で着手可能な案件もあります。' }
];

// Cloudflare Turnstile（spam 防护）—— 留空则用纯 honeypot
// 在 Cloudflare Dashboard → Turnstile → Add site 获取 site key + secret key
//   site key 填 PUBLIC_TURNSTILE_SITE_KEY（前端渲染 widget）
//   secret key 填 TURNSTILE_SECRET（后端验证；web3forms 会自己验证）
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

// Form submission success state（web3forms redirect 到 ?submitted=1）
const isSubmitted = Astro.url.searchParams.get('submitted') === '1';
---
<Layout title="お問い合わせ | 東栄創産グループ" description="OEM製造・跨境電商・国際貿易のお問い合わせはこちらから。24時間以内に返信いたします。">
  <Nav />

  <PageHero eyebrow="CONTACT" title="お問い合わせ" subtitle="まずはお気軽にご相談ください。24時間以内に返信いたします。" />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="form-wrap" id="contact-wrap">
          <h2>フォームから問い合わせる</h2>
          <div class="success-card" id="contact-success" role="status" aria-live="polite">
            <div class="success-icon" aria-hidden="true">✓</div>
            <h3 class="success-title">お問い合わせありがとうございました</h3>
            <p class="success-desc">担当者より <strong>24 時間以内</strong> にご返信いたします。<br />返信が届かない場合は、迷惑メールフォルダもご確認ください。</p>
            <a href="/" class="btn btn-primary">ホームに戻る</a>
          </div>
          <form class="form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
            <input type="hidden" name="access_key" value="e9b29e3d-a8ad-45e6-9f75-44a84ee2c156" />
            <input type="hidden" name="subject" value="東栄創産グループ — 新しいお問い合わせ" />
            <input type="hidden" name="from_name" value="Toei Sosan Group Website" />
            <input type="hidden" name="redirect" value="https://toei-sosan.com/contact/?submitted=1" />
            <!-- 蜜罐（防垃圾邮件，CSS 隐藏，机器人会填） -->
            <input type="checkbox" name="botcheck" class="hidden" style="display: none" />

            <div class="form-row">
              <label>
                <span>お名前 <em>*</em></span>
                <input type="text" name="name" required />
              </label>
              <label>
                <span>会社名</span>
                <input type="text" name="company" />
              </label>
            </div>
            <label>
              <span>メールアドレス <em>*</em></span>
              <input type="email" name="email" required />
            </label>
            <label>
              <span>関心のあるサービス</span>
              <select name="service">
                <option>OEM製造</option>
                <option>跨境電商</option>
                <option>国際貿易</option>
                <option>製品設計</option>
                <option>その他</option>
              </select>
            </label>
            <label>
              <span>相談内容 <em>*</em></span>
              <textarea name="message" rows="6" required></textarea>
            </label>
            <label class="check">
              <input type="checkbox" name="agree" required />
              <span>プライバシーポリシーに同意する</span>
            </label>

            {TURNSTILE_SITE_KEY ? (
              <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-callback="onTurnstileSuccess"></div>
            ) : (
              <noscript>
                <p style="font-size:0.875rem;color:var(--color-text-soft);">
                  ※ JavaScript を有効にしてください（スパム対策のため）
                </p>
              </noscript>
            )}

            <button type="submit" class="btn btn-primary" id="contact-submit">送信する</button>
          </form>
        </div>

        <aside class="info-wrap">
          <h2>連絡先</h2>
          <div class="info-block">
            <div class="info-label">メール</div>
            <a href="mailto:info@toei-sosan.com" class="info-value">info@toei-sosan.com</a>
          </div>
          <div class="info-block">
            <div class="info-label">日本本社 (埼玉)</div>
            <p class="info-value">
              〒343-0828<br />
              埼玉県越谷市レイクタウン八丁目8番地125号
            </p>
          </div>
          <div class="info-block">
            <div class="info-label">中国拠点</div>
            <p class="info-value">広東省東莞市東城街道</p>
          </div>
          <div class="info-block">
            <div class="info-label">営業時間</div>
            <p class="info-value">平日 9:00 - 18:00（日本時間）</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container narrow">
      <SectionHeader eyebrow="FAQ" title="よくある質問" />
      <div class="faq-list">
        {faq.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  {TURNSTILE_SITE_KEY && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  {/* 提交时按钮 loading + disable 防止重复提交 */}
  <script>
    // 1) Static build 时 Astro.url.searchParams 是空的；
    //    所以 success card 在 build 时不会渲染，要在客户端检测 ?submitted=1
    const params = new URLSearchParams(window.location.search);
    if (params.get('submitted') === '1') {
      const form = document.getElementById('contact-form');
      const successCard = document.getElementById('contact-success');
      if (form) form.style.display = 'none';
      if (successCard) {
        successCard.style.display = 'block';
        successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // 2) 提交时按钮 loading + disable
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    if (form && submitBtn) {
      form.addEventListener('submit', () => {
        submitBtn.classList.add('is-loading');
        submitBtn.disabled = true;

        // v1.14: dual-POST — 表单同时发一份到 Trade OS (不阻塞 Web3Forms 邮件流程)
        // Web3Forms 原生 webhook 是付费, 改用浏览器 JS 同表单同时发 2 份
        // 失败不打扰用户, 邮件已通过 Web3Forms 发出
        const formData = new FormData(form);
        fetch('https://app.maclog.cn/api/inquiries/webhook/web3forms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(formData)),
        }).catch((err) => {
          console.warn('Trade OS 同步失败, 但邮件已发:', err);
        });
      });
    }
  </script>
</Layout>

<style>
  .success-card {
    display: none;
    background: linear-gradient(135deg, var(--color-bg) 0%, var(--color-bg-white) 100%);
    border: 1.5px solid var(--color-accent);
    border-radius: 4px;
    padding: 3rem 2rem;
    text-align: center;
    animation: successIn 0.5s var(--ease) both;
  }
  .success-icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--color-accent);
    color: white;
    font-size: 2rem;
    font-weight: 700;
    line-height: 64px;
    margin: 0 auto 1.5rem;
    box-shadow: 0 4px 16px rgba(226, 156, 82, 0.3);
  }
  .success-title {
    font-size: 1.375rem;
    color: var(--color-primary);
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .success-desc {
    color: var(--color-text-soft);
    line-height: 1.8;
    margin: 0 0 2rem;
  }
  .success-desc strong { color: var(--color-accent); }
  @keyframes successIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 提交按钮 loading 态 */
  .form button[type="submit"].is-loading {
    opacity: 0.7;
    pointer-events: none;
    position: relative;
    color: transparent;
  }
  .form button[type="submit"].is-loading::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 18px; height: 18px;
    margin: -9px 0 0 -9px;
    border: 2px solid rgba(255,255,255,0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .contact-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; }
  .form-wrap h2, .info-wrap h2 { font-size: 1.25rem; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
  .form { display: flex; flex-direction: column; gap: 1.5rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .form label { display: flex; flex-direction: column; gap: 0.5rem; }
  .form label > span { font-size: 0.875rem; font-weight: 500; color: var(--color-text); }
  .form label > span em { color: var(--color-accent); font-style: normal; margin-left: 0.25rem; }
  .form input, .form textarea, .form select {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-white);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }
  .form input:focus, .form textarea:focus, .form select:focus { outline: none; border-color: var(--color-primary); }
  .form textarea { resize: vertical; min-height: 140px; }
  .form .check { flex-direction: row; align-items: center; gap: 0.5rem; }
  .form .check span { font-size: 0.875rem; color: var(--color-text-soft); }
  .form button { align-self: flex-start; margin-top: 0.5rem; }
  .info-wrap { background: var(--color-bg-white); border: 1px solid var(--color-border-soft); padding: 2.5rem; }
  .info-block { margin-bottom: 1.75rem; }
  .info-block:last-child { margin-bottom: 0; }
  .info-label { font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.15em; margin-bottom: 0.5rem; }
  .info-value { font-size: 0.9375rem; color: var(--color-text); line-height: 1.6; margin: 0; }
  .faq-section { background: var(--color-bg-white); }
  .narrow { max-width: 720px; margin: 0 auto; }
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-item { background: var(--color-bg); border: 1px solid var(--color-border-soft); padding: 1.25rem 1.5rem; }
  .faq-item summary { font-weight: 500; color: var(--color-primary); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--color-accent); transition: transform 0.2s; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: 1rem 0 0; color: var(--color-text-soft); line-height: 1.7; }
  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; } .form-row { grid-template-columns: 1fr; } }
</style>
