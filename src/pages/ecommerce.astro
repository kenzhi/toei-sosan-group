---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const platforms = [
  { region: '日本', items: ['Amazon JP', '楽天市場', 'Yahoo!ショッピング', 'Shopify Plus', 'Qoo10 JAPAN'] },
  { region: '中国', items: ['天猫 (Tmall)', '京東 (JD.com)', '拼多多 (Pinduoduo)', '抖音电商 (Douyin)', '小红书 (Xiaohongshu)'] },
  { region: '東南アジア', items: ['Shopee', 'Lazada', 'Tokopedia', 'TikTok Shop'] },
  { region: '越境', items: ['Amazon US / EU', 'AliExpress', 'eBay', 'TikTok Shop Global'] }
];

const services = [
  { num: '01', title: '出品・ストア構築', desc: '各プラットフォームの規約・商習慣に合わせた商品ページ作成。多言語対応・画像制作・SEO 対策まで。' },
  { num: '02', title: '物流・FBA 納品', desc: '東莞工場および提携倉庫から各国の FBA 倉庫へ直送。日本向け FBA / 越境 FBA ともに最短 7 日で納品。' },
  { num: '03', title: 'カスタマーサポート', desc: '日中英 3 言語で対応。レビュー返信、返品対応、商品 Q&A まで 365 日体制で運用。' },
  { num: '04', title: '広告・CRM', desc: 'Amazon Ads / 楽天 RMS / 抖音投放。LTV 最大化のための CRM・メールマガジン設計まで。' }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://toei-sosan.com/ecommerce/#service',
  name: '越境EC & デジタルマーケティング',
  alternateName: 'Cross-border E-commerce',
  description: 'Amazon / 楽天 / 天猫 / Shopee など 15+ プラットフォームに出品。物流・FBA / カスタマーサポート / 広告運用まで統合運営。',
  provider: { '@type': 'Organization', name: '東栄創産グループ株式会社', url: 'https://toei-sosan.com/' },
  areaServed: ['JP', 'CN', 'US', 'EU', 'ASEAN'],
  serviceType: 'Cross-border E-commerce Operations'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://toei-sosan.com/' },
    { '@type': 'ListItem', position: 2, name: '越境EC & デジタルマーケティング', item: 'https://toei-sosan.com/ecommerce/' }
  ]
};
---
<Layout title="越境EC & デジタルマーケティング | 東栄創産グループ" description="Amazon / 楽天 / 天猫 / Shopee など 15+ プラットフォームに出品。物流・FBA / カスタマーサポート / 広告運用まで統合運営。">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <Nav />

  <PageHero
    eyebrow="E-COMMERCE"
    title="越境EC & デジタルマーケティング"
    subtitle="15+ プラットフォームに出品。物流・CS・広告運用を統合し、グロス売上の最大化を実現。"
  />

  <section class="section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>PLATFORMS</span></div>
      <h2 class="sec-title">対応プラットフォーム</h2>
      <div class="platforms-grid">
        {platforms.map(p => (
          <div class="platform-card">
            <div class="platform-region">{p.region}</div>
            <ul class="platform-list">
              {p.items.map(i => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>SERVICES</span></div>
      <h2 class="sec-title">提供サービス</h2>
      <div class="services-grid">
        {services.map(s => (
          <div class="service-card">
            <div class="service-num">{s.num}</div>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h3>越境EC、<br />戦略設計から運用までご相談ください。</h3>
        <a href="/contact/" class="btn btn-primary">お問い合わせ</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .sec-eyebrow {
    display: flex; align-items: center; gap: 0.75rem;
    color: var(--color-accent);
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    margin-bottom: 1rem;
  }
  .eyebrow-line { width: 32px; height: 1px; background: var(--color-accent); }
  .sec-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-primary);
    margin: 0 0 2.5rem;
    font-weight: 600;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .platform-card {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-soft);
    border-top: 3px solid var(--color-accent);
    padding: 1.75rem 1.5rem;
  }
  .platform-region {
    font-family: var(--font-en);
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.2em;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  .platform-list {
    list-style: none;
    padding: 0; margin: 0;
  }
  .platform-list li {
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--color-border-soft);
    color: var(--color-primary);
    font-size: 0.9375rem;
  }
  .platform-list li:last-child { border-bottom: none; }

  .services-section { background: var(--color-bg); }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .service-card {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border-soft);
    padding: 2rem;
  }
  .service-num {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-accent);
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.75rem;
  }
  .service-title {
    font-size: 1.25rem;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .service-desc {
    color: var(--color-text-soft);
    line-height: 1.8;
    font-size: 0.9375rem;
    margin: 0;
  }

  .cta-banner {
    background: var(--color-primary);
    color: white;
    padding: 3.5rem 2.5rem;
    text-align: center;
  }
  .cta-banner h3 { color: white; margin-bottom: 2rem; line-height: 1.5; }

  @media (max-width: 1024px) {
    .platforms-grid { grid-template-columns: repeat(2, 1fr); }
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
