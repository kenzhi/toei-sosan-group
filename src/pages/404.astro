---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLangFromPath, type Lang } from '../i18n/ui';

const lang: Lang = getLangFromPath(Astro.url.pathname);

const t = {
  ja: {
    eyebrow: '404 ERROR',
    title: 'ページが見つかりません',
    desc: 'お探しのページは、移動または削除された可能性があります。',
    primary: 'ホームに戻る',
    secondary: 'お問い合わせ',
    note: 'URL を直接入力された場合は、スペルをご確認ください。',
  },
  zh: {
    eyebrow: '404 ERROR',
    title: '页面未找到',
    desc: '您查找的页面可能已被移动或删除。',
    primary: '返回首页',
    secondary: '联系我们',
    note: '如果您直接输入了 URL，请检查拼写是否正确。',
  },
  en: {
    eyebrow: '404 ERROR',
    title: 'Page Not Found',
    desc: "The page you're looking for may have been moved or deleted.",
    primary: 'Back to Home',
    secondary: 'Contact Us',
    note: 'If you typed the URL directly, please check the spelling.',
  },
}[lang];

const homeHref = lang === 'ja' ? '/' : `/${lang}/`;
const contactHref = lang === 'ja' ? '/contact/' : `/${lang}/contact/`;
---
<Layout title={`404 - ${t.title}`} description={t.desc} lang={lang}>
  <Nav />

  <section class="notfound">
    <div class="container">
      <div class="notfound-inner">
        <div class="big-404">
          <span class="digit">4</span>
          <span class="digit middle">0</span>
          <span class="digit">4</span>
        </div>
        <div class="eyebrow">{t.eyebrow}</div>
        <h1 class="nf-title">{t.title}</h1>
        <p class="nf-desc">{t.desc}</p>
        <p class="nf-note">{t.note}</p>
        <div class="nf-actions">
          <a href={homeHref} class="btn-primary">{t.primary}</a>
          <a href={contactHref} class="btn-secondary">{t.secondary}</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .notfound {
    min-height: calc(100vh - 70px - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 0 4rem;
    background: linear-gradient(180deg, white 0%, var(--color-bg) 100%);
    position: relative;
    overflow: hidden;
  }

  .notfound::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--color-primary-fade) 0%, transparent 70%);
    pointer-events: none;
  }

  .notfound-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
  }

  .big-404 {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }
  .big-404 .digit {
    font-size: clamp(6rem, 18vw, 11rem);
    color: var(--color-primary);
    opacity: 0.08;
    letter-spacing: -0.04em;
    display: inline-block;
  }
  .big-404 .digit.middle {
    opacity: 1;
    color: var(--color-primary);
    transform: rotate(-8deg);
    position: relative;
    margin: 0 -0.25rem;
  }
  .big-404 .digit.middle::before {
    content: '';
    position: absolute;
    bottom: 12%;
    left: 8%;
    right: 8%;
    height: 4px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .eyebrow {
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 1.25rem;
    line-height: 1.3;
  }

  .nf-desc {
    font-family: var(--font-sc);
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-soft);
    margin: 0 0 1.5rem;
  }

  .nf-note {
    font-family: var(--font-sc);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-mute);
    margin: 0 0 2.5rem;
  }

  .nf-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .nf-actions .btn-primary,
  .nf-actions .btn-secondary {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s var(--ease);
  }

  .nf-actions .btn-primary {
    background: var(--color-primary);
    color: white;
    border: 1.5px solid var(--color-primary);
  }
  .nf-actions .btn-primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(27, 58, 92, 0.25);
  }

  .nf-actions .btn-secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }
  .nf-actions .btn-secondary:hover {
    background: var(--color-primary);
    color: white;
  }

  @media (max-width: 640px) {
    .big-404 { gap: 0.25rem; }
    .big-404 .digit { font-size: 6rem; }
  }
</style>
