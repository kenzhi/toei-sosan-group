---
import ProductLayout from '../../components/ProductLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../i18n/ui';

export async function getStaticPaths() {
  const products = await getCollection('products', p => p.data.lang === 'ja');
  const cases = await getCollection('cases', c => c.data.lang === 'ja');
  return Promise.all(products.map(async (entry) => {
    const relatedCaseEntry = (entry.data as any).relatedCase
      ? cases.find(c => c.slug.startsWith((entry.data as any).relatedCase + '.'))
      : undefined;
    const relatedProducts = (await getCollection('products', p =>
      p.data.lang === 'ja' && p.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, relatedCaseEntry, relatedProducts } };
  }));
}

const { entry, relatedCaseEntry, relatedProducts } = Astro.props;
---
<ProductLayout
  entry={entry}
  backLabel="製品一覧"
  backHref="/products/"
  ctaTitle="この製品の見積もり依頼"
  ctaButton="お問い合わせ"
  ctaHref="/contact/"
  relatedCaseEntry={relatedCaseEntry}
  relatedProducts={relatedProducts}
  lang="ja"
/>
