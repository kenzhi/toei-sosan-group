---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../i18n/ui';

const cases = (await getCollection('cases', c => c.data.lang === 'ja' && !c.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="ケース | 東栄創産グループ" description="東栄創産グループが手がけたプロジェクトの事例。">
  <Nav />
  <PageHero eyebrow="CASE STUDIES" title="ケース" subtitle="東栄創産が手がけたプロジェクトの事例。" />
  <section class="section">
    <div class="container">
      <div class="article-list">
        {cases.map(c => (
          <a href={`/cases/${cleanSlug(c.slug)}/`} class="article-card">
            <div class="article-meta">
              <time>{c.data.date.toISOString().split('T')[0]}</time>
              {c.data.industry && <span class="tag">{c.data.industry}</span>}
              {c.data.service && <span class="tag">{c.data.service}</span>}
            </div>
            <h2>{c.data.title}</h2>
            <p>{c.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .article-list { display: grid; gap: 1.5rem; }
  .article-card { display: block; padding: 2.5rem; background: var(--color-bg-white); border: 1px solid var(--color-border-soft); transition: all 0.3s; text-decoration: none; }
  .article-card:hover { border-color: var(--color-accent); transform: translateY(-3px); }
  .article-meta { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
  .article-meta time { font-size: 0.875rem; color: var(--color-text-mute); }
  .tag { font-size: 0.75rem; color: var(--color-accent); padding: 0.125rem 0.625rem; border: 1px solid var(--color-accent); border-radius: 2px; }
  .article-card h2 { font-size: 1.375rem; margin-bottom: 0.75rem; }
  .article-card p { color: var(--color-text-soft); margin: 0; font-size: 0.9375rem; line-height: 1.7; }
</style>
