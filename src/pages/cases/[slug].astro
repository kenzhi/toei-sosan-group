---
import ArticleLayout from '../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../i18n/ui';

export async function getStaticPaths() {
  const cases = await getCollection('cases', c => c.data.lang === 'ja');
  return Promise.all(cases.map(async (entry) => {
    const related = (await getCollection('cases', c =>
      c.data.lang === 'ja' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="cases"
  backLabel="ケース一覧"
  backHref="/cases/"
  ctaTitle="あなたのプロジェクトも、やり切りませんか？"
  ctaButton="お問い合わせ"
  ctaHref="/contact/"
  relatedTitle="ケース"
  related={related}
  lang="ja"
/>
