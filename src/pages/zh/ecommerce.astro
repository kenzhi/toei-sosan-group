---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

const platforms = [
  { region: '日本', items: ['Amazon JP', '乐天市场', 'Yahoo!购物', 'Shopify Plus', 'Qoo10 JAPAN'] },
  { region: '中国', items: ['天猫', '京东', '拼多多', '抖音电商', '小红书'] },
  { region: '东南亚', items: ['Shopee', 'Lazada', 'Tokopedia', 'TikTok Shop'] },
  { region: '跨境', items: ['Amazon US / EU', 'AliExpress', 'eBay', 'TikTok Shop Global'] }
];

const services = [
  { num: '01', title: '上架·店铺搭建', desc: '针对各平台规则与用户习惯制作商品页。多语言支持、图片制作、SEO 优化全包。' },
  { num: '02', title: '物流·FBA 配送', desc: '中国保税仓直发各国 FBA 仓。日本 FBA / 跨境 FBA 最短 7 天送达。' },
  { num: '03', title: '客户支持', desc: '中日英三语服务。评价回复、退货处理、商品 Q&A 全年 365 天。' },
  { num: '04', title: '广告·CRM', desc: 'Amazon Ads / 乐天 RMS / 抖音投放。LTV 最大化的 CRM 与 EDM 设计。' }
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://toei-sosan.com/zh/ecommerce/#service',
  name: '跨境电商·数字营销',
  alternateName: 'Cross-border E-commerce',
  description: '15+ 平台同步运营：Amazon / 乐天 / 天猫 / Shopee。物流 FBA / 客户支持 / 广告投放一站运营。',
  provider: { '@type': 'Organization', name: '东荣创产集团股份有限公司', url: 'https://toei-sosan.com/zh/' },
  areaServed: ['JP', 'CN', 'US', 'EU', 'ASEAN'],
  serviceType: 'Cross-border E-commerce Operations'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: 'https://toei-sosan.com/zh/' },
    { '@type': 'ListItem', position: 2, name: '跨境电商·数字营销', item: 'https://toei-sosan.com/zh/ecommerce/' }
  ]
};
---
<Layout title="跨境电商·数字营销 | 东荣创产集团" description="15+ 平台同步运营：Amazon / 乐天 / 天猫 / Shopee。物流 FBA / 客户支持 / 广告投放一站搞定。" lang="zh">
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <Nav />

  <PageHero
    eyebrow="E-COMMERCE"
    title="跨境电商·数字营销"
    subtitle="15+ 平台同步运营。整合物流·客服·广告，最大化销售总额。"
  />

  <section class="section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>PLATFORMS</span></div>
      <h2 class="sec-title">支持平台</h2>
      <div class="platforms-grid">
        {platforms.map(p => (
          <div class="platform-card">
            <div class="platform-region">{p.region}</div>
            <ul class="platform-list">
              {p.items.map(i => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="sec-eyebrow"><span class="eyebrow-line"></span><span>SERVICES</span></div>
      <h2 class="sec-title">服务内容</h2>
      <div class="services-grid">
        {services.map(s => (
          <div class="service-card">
            <div class="service-num">{s.num}</div>
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <h3>跨境电商，<br />从战略规划到运营一站咨询。</h3>
        <a href="/zh/contact/" class="btn btn-primary">联系我们</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .sec-eyebrow { display: flex; align-items: center; gap: 0.75rem; color: var(--color-accent); font-family: var(--font-en); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.35em; margin-bottom: 1rem; }
  .eyebrow-line { width: 32px; height: 1px; background: var(--color-accent); }
  .sec-title { font-family: var(--font-display); font-size: clamp(1.75rem, 3vw, 2.5rem); color: var(--color-primary); margin: 0 0 2.5rem; font-weight: 600; }
  .platforms-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .platform-card { background: var(--color-bg-white); border: 1px solid var(--color-border-soft); border-top: 3px solid var(--color-accent); padding: 1.75rem 1.5rem; }
  .platform-region { font-family: var(--font-en); font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.2em; margin-bottom: 1rem; font-weight: 600; }
  .platform-list { list-style: none; padding: 0; margin: 0; }
  .platform-list li { padding: 0.5rem 0; border-bottom: 1px dashed var(--color-border-soft); color: var(--color-primary); font-size: 0.9375rem; }
  .platform-list li:last-child { border-bottom: none; }
  .services-section { background: var(--color-bg); }
  .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .service-card { background: var(--color-bg-white); border: 1px solid var(--color-border-soft); padding: 2rem; }
  .service-num { font-family: var(--font-display); font-size: 2rem; color: var(--color-accent); font-weight: 600; line-height: 1; margin-bottom: 0.75rem; }
  .service-title { font-size: 1.25rem; color: var(--color-primary); margin: 0 0 0.75rem; font-weight: 600; }
  .service-desc { color: var(--color-text-soft); line-height: 1.8; font-size: 0.9375rem; margin: 0; }
  .cta-banner { background: var(--color-primary); color: white; padding: 3.5rem 2.5rem; text-align: center; }
  .cta-banner h3 { color: white; margin-bottom: 2rem; line-height: 1.5; }
  @media (max-width: 1024px) {
    .platforms-grid { grid-template-columns: repeat(2, 1fr); }
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
