---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import PageHero from '../../../components/PageHero.astro';
import Footer from '../../../components/Footer.astro';

const items = [
  {
    src: '/images/site/past-products/cableprotectors-1.jpg',
    label: '数据线保护套（角色造型）',
    process: '注塑 + 涂装 + 组装',
    material: 'PVC / 软质树脂',
  },
  {
    src: '/images/site/past-products/cableprotectors-2.jpg',
    label: '数据线保护套（多款式）',
    process: '注塑 + 涂装 + 组装',
    material: 'PVC / 软质树脂',
  },
  {
    src: '/images/site/past-products/usbcables.jpg',
    label: 'USB 充电线（带角色保护套）',
    process: '注塑 + 组装 + 包装',
    material: 'PVC / TPE / 线材',
  },
  {
    src: '/images/site/past-products/charger-dalmatian.jpg',
    label: 'USB 充电器（动物造型 / 零售包装）',
    process: '注塑 + 组装 + 包装',
    material: 'ABS / PVC / 零售包装',
  },
  {
    src: '/images/site/past-products/charger.jpg',
    label: 'USB 墙充充电器',
    process: '注塑 + 组装',
    material: 'ABS / PC',
  },
  {
    src: '/images/site/past-products/anpanman.jpg',
    label: '面包超人面包工厂 玩具套装',
    process: '注塑 + 涂装 + 组装 + 包装',
    material: 'ABS / PVC',
  },
  {
    src: '/images/site/past-products/spiderman.jpg',
    label: '人偶公仔（Funko 风格）',
    process: '注塑 + 涂装 + 组装',
    material: 'PVC / 涂装',
  },
];
---
<Layout title="过往产品 | 东荣创产集团" description="东荣创产集团 OEM 制造的产品样例（部分已处理）。">
  <Nav />
  <PageHero
    eyebrow="PAST PRODUCTS"
    title="过往产品样例"
    subtitle="东荣创产集团 OEM 制造的实例。角色玩具、USB 配件、充电器，中国东莞自营工厂一贯生产。"
  />
  <section class="section">
    <div class="container">
      <div class="note">
        ※ 部分图片因相关角色肖像权 / IP 保护，已对脸部进行马赛克处理。作为产品本体 / 规格 / 加工精度的参考。
      </div>
      <div class="gallery">
        {items.map(it => (
          <figure class="card">
            <div class="img-wrap">
              <img src={it.src} alt={it.label} loading="lazy" />
            </div>
            <figcaption>
              <h3>{it.label}</h3>
              <dl>
                <dt>主要工序</dt><dd>{it.process}</dd>
                <dt>主要材料</dt><dd>{it.material}</dd>
              </dl>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .section { padding: 4rem 0 6rem; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }
  .note {
    font-size: 0.875rem;
    color: #5A5A5A;
    background: #F7F4ED;
    border-left: 3px solid #E29C52;
    padding: 0.875rem 1.125rem;
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }
  .card {
    margin: 0;
    background: #FFFFFF;
    border: 1px solid #E8E2D5;
    transition: all 0.3s;
    overflow: hidden;
  }
  .card:hover {
    border-color: #1B3A5C;
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(27,58,92,0.08);
  }
  .img-wrap {
    aspect-ratio: 4/3;
    overflow: hidden;
    background: #F4F0E6;
  }
  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  figcaption h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1B3A5C;
    margin: 0 0 0.75rem 0;
    line-height: 1.5;
  }
  figcaption dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  figcaption dt {
    color: #8A8A8A;
    font-weight: 500;
  }
  figcaption dd {
    color: #1B3A5C;
    margin: 0;
  }
</style>
