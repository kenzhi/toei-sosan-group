---
import ArticleLayout from '../../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const cases = await getCollection('cases', c => c.data.lang === 'zh');
  return Promise.all(cases.map(async (entry) => {
    const related = (await getCollection('cases', c =>
      c.data.lang === 'zh' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="cases"
  backLabel="案例列表"
  backHref="/zh/cases/"
  ctaTitle="您的项目也想被我们执行到底？"
  ctaButton="联系我们"
  ctaHref="/zh/contact/"
  relatedTitle="案例"
  related={related}
  lang="zh"
/>
