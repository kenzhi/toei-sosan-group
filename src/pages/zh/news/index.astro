---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import PageHero from '../../../components/PageHero.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

const news = (await getCollection('news', n => n.data.lang === 'zh' && !n.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="新闻 | 东荣创产集团" description="东荣创产集团的新服务、公告、合作信息。">
  <Nav />
  <PageHero eyebrow="NEWS" title="新闻" subtitle="新服务、公告、合作信息等。" />
  <section class="section">
    <div class="container">
      <div class="article-list">
        {news.map(n => (
          <a href={`/zh/news/${cleanSlug(n.slug)}/`} class="article-card">
            <div class="article-meta">
              <time>{n.data.date.toISOString().split('T')[0]}</time>
              <span class="tag">{n.data.type === 'announcement' ? '公告' : n.data.type === 'service' ? '服务' : '合作'}</span>
            </div>
            <h2>{n.data.title}</h2>
            <p>{n.data.excerpt}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .article-list { display: grid; gap: 1.5rem; }
  .article-card { display: block; padding: 2.5rem; background: var(--color-bg-white); border: 1px solid var(--color-border-soft); transition: all 0.3s; text-decoration: none; }
  .article-card:hover { border-color: var(--color-accent); transform: translateY(-3px); }
  .article-meta { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; }
  .article-meta time { font-size: 0.875rem; color: var(--color-text-mute); }
  .tag { font-size: 0.75rem; color: var(--color-accent); padding: 0.125rem 0.625rem; border: 1px solid var(--color-accent); border-radius: 2px; }
  .article-card h2 { font-size: 1.375rem; margin-bottom: 0.75rem; }
  .article-card p { color: var(--color-text-soft); margin: 0; font-size: 0.9375rem; line-height: 1.7; }
</style>
