---
import ArticleLayout from '../../../components/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { cleanSlug } from '../../../i18n/ui';

export async function getStaticPaths() {
  const news = await getCollection('news', c => c.data.lang === 'zh');
  return Promise.all(news.map(async (entry) => {
    const related = (await getCollection('news', c =>
      c.data.lang === 'zh' && c.slug !== entry.slug
    )).slice(0, 3);
    return { params: { slug: cleanSlug(entry.slug) }, props: { entry, related } };
  }));
}

const { entry, related } = Astro.props;
---
<ArticleLayout
  entry={entry}
  collection="news"
  backLabel="新闻列表"
  backHref="/zh/news/"
  ctaTitle="想了解最新动态？"
  ctaButton="联系我们"
  ctaHref="/zh/contact/"
  relatedTitle="新闻"
  related={related}
  lang="zh"
/>
