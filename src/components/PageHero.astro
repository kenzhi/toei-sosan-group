---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
---
<section class:list={['page-hero', `align-${align}`]}>
  <div class="container">
    <div class="sec-eyebrow">
      <span class="eyebrow-line"></span>
      <span class="eyebrow-text">{eyebrow}</span>
    </div>
    <h1 class="page-title">{title}</h1>
    {subtitle && <p class="page-sub">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: 6rem 0 4rem;
    background: linear-gradient(180deg, var(--color-bg-white) 0%, var(--color-bg) 100%);
    position: relative;
    overflow: hidden;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent) 50%, transparent 100%);
  }
  .page-hero.align-center { text-align: center; }
  .page-hero.align-center .sec-eyebrow { justify-content: center; }
  .page-hero.align-center .page-sub { margin: 0 auto; }
  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .eyebrow-line { display: block; width: 32px; height: 2px; background: var(--color-accent); border-radius: 999px; }
  .eyebrow-text {
    font-family: var(--font-en);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-primary);
    opacity: 0.6;
    text-transform: uppercase;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.2;
    margin: 0 0 1.25rem;
    letter-spacing: -0.005em;
  }
  .page-sub {
    font-family: var(--font-sc);
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text-soft);
    margin: 0;
    max-width: 40rem;
  }
</style>
