---
import { ui, getLangFromPath, type Lang } from '../i18n/ui';

const currentPath = Astro.url.pathname;
const currentLang: Lang = getLangFromPath(currentPath);
const t = ui[currentLang];
const year = new Date().getFullYear();

const officeLabels = {
  ja: { tokyo: 'TOKYO OFFICE', dongguan: 'DONGGUAN OFFICE', contact: 'CONTACT' },
  zh: { tokyo: '东京总部',    dongguan: '东莞据点',        contact: '联系我们' },
  en: { tokyo: 'TOKYO OFFICE', dongguan: 'DONGGUAN OFFICE', contact: 'CONTACT' },
};
const labels = officeLabels[currentLang];

const officeAddresses = {
  ja: {
    tokyo: '〒140-0002<br/>東京都品川区東品川4-12-4<br/>品川インターシティC棟 6F',
    dongguan: '中国広東省東莞市<br/>長安鎮烏沙社区振安中路<br/>東栄創産工業園',
  },
  zh: {
    tokyo: '〒140-0002<br/>东京都品川区东品川 4-12-4<br/>品川 Intercity C 栋 6F',
    dongguan: '中国广东省东莞市<br/>长安镇乌沙社区振安中路<br/>东荣创产工业园',
  },
  en: {
    tokyo: '4-12-4 Higashi-Shinagawa, Shinagawa-ku,<br/>Tokyo 140-0002, Japan<br/>Shinagawa Intercity C Bldg. 6F',
    dongguan: 'Zhen\'an Middle Rd, Wusha Community,<br/>Chang\'an Town, Dongguan,<br/>Guangdong, China',
  },
};
const addrs = officeAddresses[currentLang];
---
<footer class="footer">
  <!-- 顶部 accent line -->
  <div class="footer-top-line"></div>

  <div class="container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="brand-col">
        <div class="brand">
          <span class="brand-mark">
            <span class="brand-kanji">東</span>
          </span>
          <span class="brand-en">TOEI SOSAN GROUP</span>
        </div>
        <p class="brand-tag" set:html={t.footer.brandTag ?? t.footer.address}></p>
      </div>

      <!-- Tokyo Office -->
      <div class="addr-col">
        <h5>{labels.tokyo}</h5>
        <p set:html={addrs.tokyo}></p>
      </div>

      <!-- Dongguan Office -->
      <div class="addr-col">
        <h5>{labels.dongguan}</h5>
        <p set:html={addrs.dongguan}></p>
      </div>

      <!-- Contact -->
      <div class="contact-col">
        <h5>{labels.contact}</h5>
        <p>info@toei-sosan.com<br/>+81-3-6718-2456</p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <span>© {year} TOEI SOSAN GROUP CO., LTD. ALL RIGHTS RESERVED.</span>
      <div class="footer-legal">
        <a href="#">PRIVACY POLICY</a>
        <a href="#">TERMS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: rgba(255, 255, 255, 0.7);
    padding: 4rem 0 1.5rem;
    position: relative;
    margin-top: var(--space-section);
  }
  .footer-top-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent-fade) 50%, transparent 100%);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 0.8fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .brand-mark {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-accent-fade);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-kanji {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: white;
  }
  .brand-en {
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: white;
  }
  .brand-tag {
    font-family: var(--font-sc);
    font-size: 0.75rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }
  h5 {
    font-family: var(--font-en);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--color-accent);
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }
  .addr-col p, .contact-col p {
    font-family: var(--font-sc);
    font-size: 0.75rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-en);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.3);
  }
  .footer-legal { display: flex; gap: 1.5rem; }
  .footer-legal a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(255, 255, 255, 0.8); }
  @media (max-width: 1023px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .brand-col { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .brand-col { grid-column: span 1; }
    .footer-bottom { flex-direction: column; gap: 0.75rem; text-align: center; }
  }
</style>
