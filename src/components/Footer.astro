---
import { ui, getLangFromPath, type Lang } from '../i18n/ui';
import LastUpdated from './LastUpdated.astro';

const currentPath = Astro.url.pathname;
const currentLang: Lang = getLangFromPath(currentPath);
const t = ui[currentLang];
const year = new Date().getFullYear();

const officeLabels = {
  ja: { hq: '日本本社 (SAITAMA HQ)', factory: '東莞工廠 (DONGGUAN FACTORY)', contact: 'CONTACT' },
  zh: { hq: '日本总部 (SAITAMA HQ)', factory: '东莞工厂 (DONGGUAN FACTORY)', contact: '联系我们' },
  en: { hq: 'SAITAMA HQ (JAPAN)',   factory: 'DONGGUAN FACTORY (CHINA)',    contact: 'CONTACT' },
};
const labels = officeLabels[currentLang];

const officeAddresses = {
  ja: {
    hq: '〒343-0828<br/>埼玉県越谷市レイクタウン八丁目8番地125号',
    factory: '中国広東省東莞市東城街道',
  },
  zh: {
    hq: '〒343-0828<br/>埼玉县越谷市 Lake Town 八丁目8番地125号',
    factory: '中国广东省东莞市东城街道',
  },
  en: {
    hq: '8-125 Lake-Town 8-chome,<br/>Koshigaya, Saitama 343-0828, Japan',
    factory: 'Dongcheng Subdistrict,<br/>Dongguan, Guangdong, China',
  },
};
const addrs = officeAddresses[currentLang];

// Logo link — 回当前语言首页
function langPath(targetLang: Lang, p: string = currentPath): string {
  if (targetLang === 'ja') {
    if (p === '/zh' || p === '/en') return '/';
    return p.replace(/^\/(zh|en)/, '') || '/';
  }
  let stripped = p.replace(/^\/(zh|en)/, '') || '/';
  if (!stripped.endsWith('/')) stripped += '/';
  return `/${targetLang}${stripped}`;
}
const homeHref = langPath(currentLang, '/');
---
<footer class="footer">
  <!-- 顶部 accent line -->
  <div class="footer-top-line"></div>

  <div class="container">
    <div class="footer-grid">
      <!-- Brand — 点击回首页 -->
      <div class="brand-col">
        <a href={homeHref} class="brand" aria-label="TOEI SOSAN GROUP ホーム">
          <span class="brand-mark">
            <span class="brand-kanji">東</span>
          </span>
          <span class="brand-en">TOEI SOSAN GROUP</span>
        </a>
        <p class="brand-tag" set:html={t.footer.brandTag ?? t.footer.address}></p>
      </div>

      <!-- Japan HQ (Saitama) -->
      <div class="addr-col">
        <h5>{labels.hq}</h5>
        <p set:html={addrs.hq}></p>
      </div>

      <!-- Dongguan Factory -->
      <div class="addr-col">
        <h5>{labels.factory}</h5>
        <p set:html={addrs.factory}></p>
      </div>

      <!-- Contact -->
      <div class="contact-col">
        <h5>{labels.contact}</h5>
        <p><a href="mailto:info@toei-sosan.com" class="footer-link">info@toei-sosan.com</a></p>
        {/* v1.28: WhatsApp 入口 — 日本 B2B 客户首选即时通讯
             */}
        <p class="contact-whatsapp">
          <a href="https://wa.me/813012345678" class="footer-link footer-whatsapp" target="_blank" rel="noopener">
            💬 WhatsApp (Japan)
          </a>
        </p>
        <p class="contact-hours">{t.footer.hours}</p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span>© {year} TOEI SOSAN GROUP CO., LTD. ALL RIGHTS RESERVED.</span>
        <LastUpdated path={currentPath} />
      </div>
      <div class="footer-legal">
        <a href={currentLang === 'ja' ? '/privacy/' : `/${currentLang}/privacy/`}>PRIVACY POLICY</a>
        <a href={currentLang === 'ja' ? '/privacy/#terms' : `/${currentLang}/privacy/#terms`}>TERMS</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary);
    color: rgba(255, 255, 255, 0.7);
    padding: 4rem 0 1.5rem;
    position: relative;
    margin-top: var(--space-section);
  }
  .footer-top-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, var(--color-accent-fade) 50%, transparent 100%);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 0.8fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .brand:hover { opacity: 0.85; }
  .brand-mark {
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--color-accent-fade);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-kanji {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: white;
  }
  .brand-en {
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: white;
  }
  .brand-tag {
    font-family: var(--font-sc);
    font-size: 0.75rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }
  h5 {
    font-family: var(--font-en);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--color-accent);
    margin: 0 0 1rem 0;
    text-transform: uppercase;
  }
  .addr-col p, .contact-col p {
    font-family: var(--font-sc);
    font-size: 0.75rem;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
  .contact-col .contact-hours { margin-top: 0.5rem; opacity: 0.7; font-size: 0.6875rem; }
  .footer-link { color: rgba(255, 255, 255, 0.85); text-decoration: none; transition: color 0.2s; }
  .footer-link:hover { color: var(--color-accent); }
  .contact-whatsapp { margin-top: 0.4rem; }
  .footer-whatsapp { font-size: 0.8125rem; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-en);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
  }
  .footer-bottom-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
    color: rgba(255, 255, 255, 0.3);
  }
  .footer-legal { display: flex; gap: 1.5rem; }
  .footer-legal a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    letter-spacing: 0.15em;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(255, 255, 255, 0.8); }
  @media (max-width: 1023px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .brand-col { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .brand-col { grid-column: span 1; }
    .footer-bottom { flex-direction: column; gap: 0.75rem; text-align: center; }
  }
</style>
