---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { CollectionEntry } from 'astro:content';
import { cleanSlug } from '../i18n/ui';

type AnyEntry = CollectionEntry<'cases'> | CollectionEntry<'insights'> | CollectionEntry<'news'>;

interface Props {
  entry: AnyEntry;
  collection: 'cases' | 'insights' | 'news';
  backLabel: string;
  backHref: string;
  ctaTitle: string;
  ctaButton: string;
  ctaHref: string;
  relatedTitle: string;
  related?: AnyEntry[];
  coverImage?: string;
  lang: 'ja' | 'zh' | 'en';
}

const {
  entry, collection, backLabel, backHref, ctaTitle, ctaButton, ctaHref,
  relatedTitle, related = [], coverImage, lang
} = Astro.props;

const { Content } = await entry.render();
const dateStr = entry.data.date.toISOString().split('T')[0];

// Fallback cover: 灰色 abstract 背景
const defaultCovers: Record<string, string> = {
  cases: 'https://images.unsplash.com/photo-1565043666747-69f6646db940?w=1600&h=600&fit=crop&auto=format&q=80',
  insights: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1600&h=600&fit=crop&auto=format&q=80',
  news: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1600&h=600&fit=crop&auto=format&q=80',
};
const cover = coverImage || (entry.data as any).cover || defaultCovers[collection];

// TOC labels
const tocLabels = {
  ja: { toc: '目次', backToTop: '↑ トップへ', related: '関連記事' },
  zh: { toc: '目录',  backToTop: '↑ 回到顶部', related: '相关文章' },
  en: { toc: 'Contents', backToTop: '↑ Back to top', related: 'Related' },
};
const t = tocLabels[lang];

// SEO title
const pageTitle = `${(entry.data as any).title} | ${relatedTitle === '関連' ? 'ケース' : relatedTitle} | 東栄創産グループ`;

// OG image
const ogImage = cover.startsWith('http') ? cover : `https://toei-sosan.com${cover}`;

// Article JSON-LD schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': collection === 'news' ? 'NewsArticle' : 'Article',
  headline: (entry.data as any).title,
  description: (entry.data as any).excerpt,
  image: [ogImage],
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.date.toISOString(),
  inLanguage: lang === 'ja' ? 'ja-JP' : lang === 'zh' ? 'zh-CN' : 'en-US',
  author: {
    '@type': 'Organization',
    name: '東栄創産グループ株式会社',
    url: 'https://toei-sosan.com',
  },
  publisher: {
    '@type': 'Organization',
    name: '東栄創産グループ株式会社',
    logo: {
      '@type': 'ImageObject',
      url: 'https://toei-sosan.com/logo.svg',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://toei-sosan.com${lang === 'ja' ? '' : '/' + lang}/${collection}/${cleanSlug(entry.slug)}/`,
  },
  ...((entry.data as any).industry && { articleSection: (entry.data as any).industry }),
  ...((entry.data as any).tags && { keywords: (entry.data as any).tags.join(', ') }),
};
---
<Layout title={pageTitle} description={(entry.data as any).excerpt} lang={lang} ogImage={ogImage}>
  <Nav />

  <!-- 顶部阅读进度条 -->
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <article class="article">
    <!-- Cover image -->
    <div class="cover" style={`background-image: url(${cover})`}>
      <div class="cover-overlay"></div>
      <div class="container cover-content">
        <div class="cover-meta">
          {entry.data.industry && <span class="cover-tag">{entry.data.industry}</span>}
          {entry.data.service && <span class="cover-tag">{entry.data.service}</span>}
          {entry.data.category && <span class="cover-tag">{entry.data.category}</span>}
          {entry.data.type && <span class="cover-tag">{entry.data.type}</span>}
        </div>
        <h1 class="cover-title">{(entry.data as any).title}</h1>
      </div>
    </div>

    <div class="container article-grid">
      <!-- 侧栏 TOC（桌面） -->
      <aside class="toc-sidebar">
        <div class="toc-sticky">
          <h4 class="toc-heading">{t.toc}</h4>
          <nav class="toc-nav" id="tocNav"></nav>
        </div>
      </aside>

      <!-- 主内容 -->
      <main class="article-main">
        <a href={backHref} class="back-link">← {backLabel}</a>
        <div class="article-meta">
          <time>{dateStr}</time>
        </div>
        <p class="article-excerpt">{(entry.data as any).excerpt}</p>
        <div class="article-body">
          <Content />
        </div>

        <div class="article-cta">
          <p>{ctaTitle}</p>
          <a href={ctaHref} class="btn-cta">{ctaButton}</a>
        </div>

        <a href="#" class="back-to-top">{t.backToTop}</a>
      </main>
    </div>

    <!-- 相关推荐 -->
    {related.length > 0 && (
      <section class="related-section">
        <div class="container">
          <div class="sec-eyebrow">
            <span class="eyebrow-line"></span>
            <span>{t.related}</span>
          </div>
          <div class="related-grid">
            {related.map(r => {
              const slug = cleanSlug(r.slug);
              const basePath = lang === 'ja' ? '' : `/${lang}`;
              return (
                <a href={`${basePath}/${collection}/${slug}/`} class="related-card">
                  <div class="related-meta">
                    <time>{r.data.date.toISOString().split('T')[0]}</time>
                    {r.data.industry && <span class="related-tag">{r.data.industry}</span>}
                    {r.data.category && <span class="related-tag">{r.data.category}</span>}
                  </div>
                  <h4>{(r.data as any).title}</h4>
                  <p>{(r.data as any).excerpt}</p>
                  <span class="related-arrow">→</span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </article>

  <Footer />

  <!-- Article JSON-LD schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
</Layout>

<script>
  const progress = document.getElementById('readingProgress');
  const articleMain = document.querySelector('.article-main') as HTMLElement | null;
  if (progress && articleMain) {
    const updateProgress = () => {
      const rect = articleMain.getBoundingClientRect();
      const winH = window.innerHeight;
      const total = rect.height;
      const seen = Math.max(0, Math.min(total, winH - rect.top));
      const pct = Math.min(100, Math.max(0, (seen / total) * 100));
      (progress as HTMLElement).style.width = pct + '%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  }

  // Generate TOC from h2/h3 in article body
  const articleBody = document.querySelector('.article-body');
  const tocNav = document.getElementById('tocNav');
  if (articleBody && tocNav) {
    const headings = articleBody.querySelectorAll<HTMLElement>('h2, h3');
    headings.forEach((h, i) => {
      h.id = h.id || `heading-${i}`;
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent || '';
      a.className = h.tagName === 'H2' ? 'toc-h2' : 'toc-h3 toc-h3-indent';
      tocNav.appendChild(a);
    });

    if (headings.length > 0) {
      const links = Array.from(tocNav.querySelectorAll('a'));
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            links.forEach(l => l.classList.remove('active'));
            const active = tocNav.querySelector(`a[href="#${e.target.id}"]`);
            if (active) active.classList.add('active');
          }
        });
      }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
      headings.forEach(h => observer.observe(h));
    }
  }
</script>

<style>
  /* Reading progress */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    z-index: 200;
    transition: width 0.1s linear;
  }

  /* Cover */
  .cover {
    position: relative;
    height: clamp(280px, 40vw, 480px);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    margin-bottom: 0;
  }
  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(15, 23, 42, 0.75) 0%, rgba(15, 23, 42, 0.2) 60%, transparent 100%);
  }
  .cover-content {
    position: relative;
    z-index: 2;
    padding-bottom: 3rem;
    color: white;
  }
  .cover-meta {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .cover-tag {
    font-family: var(--font-en);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    background: rgba(15, 23, 42, 0.3);
    backdrop-filter: blur(4px);
  }
  .cover-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    color: white;
    line-height: 1.2;
    margin: 0;
    max-width: 800px;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.3);
  }

  /* Article grid: TOC + main */
  .article-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  /* TOC sidebar */
  .toc-sidebar { display: block; }
  .toc-sticky { position: sticky; top: 100px; }
  .toc-heading {
    font-family: var(--font-en);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-primary);
    opacity: 0.6;
    margin: 0 0 1.25rem 0;
  }
  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 1px solid var(--color-border);
    padding-left: 1rem;
  }
  .toc-nav a {
    font-family: var(--font-sc);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-soft);
    text-decoration: none;
    transition: all 0.2s var(--ease);
    display: block;
    padding: 0.15rem 0;
  }
  .toc-nav a.toc-h3-indent { padding-left: 0.75rem; font-size: 0.75rem; opacity: 0.75; }
  .toc-nav a:hover { color: var(--color-accent); }
  .toc-nav a.active {
    color: var(--color-accent);
    font-weight: 600;
  }
  .toc-nav a.active::before {
    content: '';
    position: absolute;
    left: -1rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
  }

  /* Main */
  .article-main {
    max-width: 720px;
    position: relative;
  }
  .back-link {
    display: inline-block;
    color: var(--color-text-soft);
    font-size: 0.8125rem;
    margin-bottom: 1.5rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-accent); }
  .article-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .article-meta time {
    font-family: var(--font-en);
    font-size: 0.75rem;
    color: var(--color-text-mute);
    letter-spacing: 0.1em;
  }
  .article-excerpt {
    font-family: var(--font-sc);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    margin: 0 0 2.5rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
  }

  .article-body { margin-top: 0; }
  .article-body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    scroll-margin-top: 100px;
  }
  .article-body :global(h2:first-child) { margin-top: 0; }
  .article-body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    scroll-margin-top: 100px;
  }
  .article-body :global(p) {
    font-family: var(--font-sc);
    font-size: 0.9375rem;
    line-height: 1.95;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }
  .article-body :global(ul) { margin: 1rem 0 1.5rem 1.5rem; }
  .article-body :global(li) {
    font-family: var(--font-sc);
    line-height: 1.85;
    margin-bottom: 0.5rem;
  }
  .article-body :global(strong) { color: var(--color-primary); font-weight: 600; }
  .article-body :global(em) { color: var(--color-accent); font-style: normal; }
  .article-body :global(hr) {
    margin: 2.5rem 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }
  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-soft);
    font-style: italic;
  }

  .article-cta {
    background: var(--color-primary);
    color: white;
    padding: 2.5rem;
    text-align: center;
    margin-top: 3rem;
  }
  .article-cta p {
    color: white;
    margin-bottom: 1.5rem;
    font-size: 1.0625rem;
  }
  .btn-cta {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-en);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: all 0.3s var(--ease);
  }
  .btn-cta:hover { background: white; color: var(--color-primary); transform: translateY(-1px); }

  .back-to-top {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--font-en);
    font-size: 0.75rem;
    color: var(--color-text-mute);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  .back-to-top:hover { color: var(--color-accent); }

  /* Related */
  .related-section {
    background: var(--color-bg);
    padding: 4rem 0 6rem;
    border-top: 1px solid var(--color-border);
  }
  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .sec-eyebrow .eyebrow-line { width: 32px; height: 2px; background: var(--color-accent); border-radius: 999px; }
  .sec-eyebrow span:last-child {
    font-family: var(--font-en);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-primary);
    opacity: 0.6;
    text-transform: uppercase;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .related-card {
    display: block;
    background: white;
    border: 1px solid var(--color-border-soft);
    padding: 2rem;
    text-decoration: none;
    color: var(--color-primary);
    transition: all 0.3s var(--ease);
    position: relative;
  }
  .related-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
  }
  .related-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .related-meta time {
    font-family: var(--font-en);
    font-size: 0.6875rem;
    color: var(--color-text-mute);
    letter-spacing: 0.1em;
  }
  .related-tag {
    font-family: var(--font-en);
    font-size: 0.625rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .related-card h4 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }
  .related-card p {
    font-family: var(--font-sc);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    margin: 0;
  }
  .related-arrow {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    font-size: 1.25rem;
    color: var(--color-text-mute);
    opacity: 0.4;
    transition: all 0.3s var(--ease);
  }
  .related-card:hover .related-arrow {
    color: var(--color-accent);
    opacity: 1;
    transform: translate(4px, -4px);
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .article-grid { grid-template-columns: 1fr; gap: 2rem; }
    .toc-sidebar { display: none; }
    .related-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cover { height: 240px; }
    .cover-title { font-size: 1.5rem; }
    .article-excerpt { font-size: 1rem; }
    .article-body :global(h2) { font-size: 1.25rem; }
  }
</style>
