---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
---
<div class:list={['section-header', `align-${align}`]}>
  <div class="sec-eyebrow">
    <span class="eyebrow-line"></span>
    <span class="eyebrow-text">{eyebrow}</span>
  </div>
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class="section-sub">{subtitle}</p>}
</div>

<style>
  .section-header { margin-bottom: 3.5rem; }
  .section-header.align-center { text-align: center; }
  .section-header.align-center .sec-eyebrow { justify-content: center; }
  .section-header.align-center .section-sub { margin: 0 auto; }
  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .eyebrow-line { display: block; width: 32px; height: 2px; background: var(--color-accent); border-radius: 999px; }
  .eyebrow-text {
    font-family: var(--font-en);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    color: var(--color-primary);
    opacity: 0.6;
    text-transform: uppercase;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
    margin: 0 0 1rem;
    letter-spacing: -0.005em;
  }
  .section-sub {
    font-family: var(--font-sc);
    font-size: 1rem;
    line-height: 1.85;
    color: var(--color-text-soft);
    margin: 0;
    max-width: 40rem;
  }
</style>
